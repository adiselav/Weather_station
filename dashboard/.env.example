# ============================================
# ESP32C3 WEATHER STATION DASHBOARD CONFIGURATION
# ============================================
# Rename this file to .env and fill in the values

# MongoDB Connection String
# Get your connection string from MongoDB Atlas: Database -> Connect -> Connect your application

# Format: mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority
MONGODB_URL="mongodb+srv://REPLACE_WITH_USERNAME:REPLACE_WITH_PASSWORD@REPLACE_WITH_CLUSTER.example.com/REPLACE_WITH_DATABASE?retryWrites=true&w=majority"

# Database name
DB_NAME="weather_station"

# Collection name
COLLECTION_NAME="readings"

# Port (automatically injected on Render/Railway, local uses 4000)
PORT=4000

# Auto-refresh interval in seconds (REQUIRED - no default value)
REFRESH_INTERVAL_SECONDS=30

