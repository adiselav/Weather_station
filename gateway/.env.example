# ============================================
# ESP32C3 WEATHER STATION BACKEND CONFIGURATION
# ============================================
# Rename this file to ".env" and fill in the values

# MongoDB Atlas Connection String
# Get it from MongoDB Atlas: Database -> Connect -> Connect your application
# Replace YOUR_USERNAME, YOUR_PASSWORD, and YOUR_CLUSTER with your actual credentials
MONGODB_URL="mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"

# Database name
DB_NAME="weather_station"

# Collection name
COLLECTION_NAME="readings"

# API Key for authentication (use a secure, randomly generated key)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY="GENERATE_A_SECURE_RANDOM_KEY_HERE"

# Port (automatically injected on Render/Railway, local uses 3000)
PORT=3000
